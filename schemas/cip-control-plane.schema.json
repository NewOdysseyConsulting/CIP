{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-odyssey.dev/schemas/cip-control-plane.schema.json",
  "title": "CIP Control Plane Schema",
  "type": "object",
  "properties": {
    "tenant": {
      "$ref": "#/$defs/TenantRecord"
    },
    "connectorDefinition": {
      "$ref": "#/$defs/ConnectorDefinition"
    },
    "credentialBinding": {
      "$ref": "#/$defs/CredentialBinding"
    },
    "connectorBinding": {
      "$ref": "#/$defs/ConnectorBinding"
    },
    "policyPack": {
      "$ref": "#/$defs/PolicyPack"
    },
    "agentBlueprint": {
      "$ref": "#/$defs/AgentBlueprint"
    },
    "deployment": {
      "$ref": "#/$defs/DeploymentRecord"
    },
    "runSession": {
      "$ref": "#/$defs/RunSession"
    },
    "approvalRequest": {
      "$ref": "#/$defs/ApprovalRequest"
    },
    "runEvent": {
      "$ref": "#/$defs/RunEvent"
    },
    "auditEvent": {
      "$ref": "#/$defs/AuditEvent"
    },
    "eventBatch": {
      "$ref": "#/$defs/CipEventBatch"
    },
    "ingestReceipt": {
      "$ref": "#/$defs/CipIngestReceipt"
    },
    "apiKeyRecord": {
      "$ref": "#/$defs/ApiKeyRecord"
    },
    "ingestJob": {
      "$ref": "#/$defs/IngestJobRecord"
    },
    "deadLetterJob": {
      "$ref": "#/$defs/DeadLetterJobRecord"
    },
    "evidenceBundle": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "guardrailDefinition": {
      "$ref": "#/$defs/GuardrailDefinition"
    },
    "complianceProfile": {
      "$ref": "#/$defs/ComplianceProfile"
    },
    "complianceArtifact": {
      "$ref": "#/$defs/ComplianceArtifact"
    },
    "disclosureRecord": {
      "$ref": "#/$defs/DisclosureRecord"
    },
    "humanReviewRecord": {
      "$ref": "#/$defs/HumanReviewRecord"
    }
  },
  "$defs": {
    "BaseRecord": {
      "type": "object",
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "AuditActor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "DependencyVersionReference": {
      "type": "object",
      "required": [
        "id",
        "key",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "BlueprintDependencySnapshot": {
      "type": "object",
      "required": [
        "policyPacks",
        "guardrails",
        "connectorManifests",
        "runtimeAdapterVersion"
      ],
      "properties": {
        "policyPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyVersionReference"
          }
        },
        "guardrails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyVersionReference"
          }
        },
        "connectorManifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyVersionReference"
          }
        },
        "runtimeAdapterVersion": {
          "type": "string"
        }
      }
    },
    "TenantRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "slug",
            "displayName",
            "productTier",
            "platforms",
            "regions",
            "status"
          ],
          "properties": {
            "slug": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "productTier": {
              "enum": [
                "pegasus",
                "pantheon",
                "phoenix"
              ]
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "active",
                "suspended",
                "retired"
              ]
            }
          }
        }
      ]
    },
    "ConnectorDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "key",
            "version",
            "platform",
            "displayName",
            "runtime",
            "authStrategy",
            "source",
            "capabilities",
            "status"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "driverKey": {
              "type": "string"
            },
            "driverConfig": {
              "type": "object"
            },
            "runtime": {
              "enum": [
                "mcp",
                "native",
                "http"
              ]
            },
            "authStrategy": {
              "enum": [
                "oauth2",
                "api-key",
                "service-account",
                "custom"
              ]
            },
            "source": {
              "enum": [
                "first-party",
                "partner",
                "community"
              ]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "draft",
                "active",
                "deprecated"
              ]
            },
            "metadata": {
              "type": "object"
            }
          }
        }
      ]
    },
    "CredentialBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "name",
            "provider",
            "secretRef",
            "scopes",
            "status"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "secretBackendKey": {
              "type": "string"
            },
            "secretRef": {
              "type": "string"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "rotatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            }
          }
        }
      ]
    },
    "ConnectorBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "connectorDefinitionId",
            "credentialBindingId",
            "environment",
            "alias",
            "endpoint",
            "config",
            "status"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "connectorDefinitionId": {
              "type": "string"
            },
            "credentialBindingId": {
              "type": "string"
            },
            "environment": {
              "enum": [
                "development",
                "test",
                "sandbox",
                "production"
              ]
            },
            "alias": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "config": {
              "type": "object"
            },
            "status": {
              "enum": [
                "active",
                "disabled"
              ]
            }
          }
        }
      ]
    },
    "PolicyCondition": {
      "type": "object",
      "required": [
        "path",
        "operator"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "in",
            "contains",
            "exists",
            "regex",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {}
      }
    },
    "PolicyClause": {
      "type": "object",
      "required": [
        "id",
        "name",
        "match",
        "conditions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "match": {
          "enum": [
            "all",
            "any"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyCondition"
          }
        }
      }
    },
    "PolicyRule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "severity",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "clauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyClause"
          }
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "high",
            "critical"
          ]
        },
        "action": {
          "enum": [
            "allow",
            "flag",
            "block",
            "escalate"
          ]
        }
      }
    },
    "PolicyPack": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "key",
            "name",
            "domain",
            "version",
            "ownership",
            "rules",
            "guardrailRefs",
            "status"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "domain": {
              "enum": [
                "platform",
                "security",
                "expense",
                "recruitment",
                "onboarding"
              ]
            },
            "version": {
              "type": "string"
            },
            "ownership": {
              "enum": [
                "shared",
                "tenant"
              ]
            },
            "tenantId": {
              "type": "string"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PolicyRule"
              }
            },
            "guardrailRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "draft",
                "active",
                "retired"
              ]
            }
          }
        }
      ]
    },
    "AgentBlueprint": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "key",
            "version",
            "releaseState",
            "dependencySnapshot",
            "name",
            "productTier",
            "domain",
            "description",
            "runtime",
            "connectorDefinitionIds",
            "policyPackIds",
            "guardrailDefinitionIds",
            "handoffTargets",
            "status"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "releaseState": {
              "enum": [
                "draft",
                "released",
                "deprecated"
              ]
            },
            "dependencySnapshot": {
              "$ref": "#/$defs/BlueprintDependencySnapshot"
            },
            "supersedesBlueprintId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "productTier": {
              "enum": [
                "pegasus",
                "pantheon",
                "phoenix"
              ]
            },
            "domain": {
              "enum": [
                "platform",
                "security",
                "expense",
                "recruitment",
                "onboarding"
              ]
            },
            "description": {
              "type": "string"
            },
            "runtime": {
              "type": "object"
            },
            "connectorDefinitionIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "policyPackIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guardrailDefinitionIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "handoffTargets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "structuredOutput": {
              "type": "string"
            },
            "status": {
              "enum": [
                "draft",
                "active",
                "deprecated"
              ]
            }
          }
        }
      ]
    },
    "DeploymentRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "agentBlueprintId",
            "agentBlueprintVersion",
            "environment",
            "connectorBindingIds",
            "policyPackIds",
            "status",
            "lastTransitionAt",
            "tags"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "agentBlueprintId": {
              "type": "string"
            },
            "agentBlueprintVersion": {
              "type": "string"
            },
            "environment": {
              "enum": [
                "development",
                "test",
                "sandbox",
                "production"
              ]
            },
            "connectorBindingIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "policyPackIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "provisioning",
                "active",
                "paused",
                "draining",
                "failed",
                "retired"
              ]
            },
            "deployedAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastTransitionAt": {
              "type": "string",
              "format": "date-time"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "RunSession": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "deploymentId",
            "correlationId",
            "status",
            "startedAt",
            "inputSummary"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "deploymentId": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "waiting-human",
                "completed",
                "failed"
              ]
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "inputSummary": {
              "type": "string"
            },
            "outputSummary": {
              "type": "string"
            },
            "currentApprovalRequestId": {
              "type": "string"
            },
            "traceCorrelation": {
              "type": "object"
            },
            "complianceProfileSnapshot": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ComplianceProfile"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "ApprovalRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "deploymentId",
            "sessionId",
            "checkpointId",
            "reason",
            "requestedBy",
            "status"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "deploymentId": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "checkpointId": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "requestedBy": {
              "$ref": "#/$defs/AuditActor"
            },
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected",
                "expired",
                "cancelled"
              ]
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "resolvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "resolutionComment": {
              "type": "string"
            },
            "guardrailDefinitionId": {
              "type": "string"
            },
            "policyPackId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "RunEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseRecord"
        },
        {
          "type": "object",
          "required": [
            "tenantId",
            "deploymentId",
            "sessionId",
            "type",
            "sequence",
            "occurredAt",
            "actor",
            "payload"
          ],
          "properties": {
            "tenantId": {
              "type": "string"
            },
            "deploymentId": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "type": {
              "enum": [
                "run_started",
                "tool_called",
                "tool_completed",
                "handoff_started",
                "handoff_completed",
                "guardrail_triggered",
                "policy_decided",
                "approval_requested",
                "approval_resolved",
                "disclosure_presented",
                "disclosure_acknowledged",
                "human_review_completed",
                "output_overridden",
                "stop_invoked",
                "run_completed",
                "run_failed"
              ]
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "actor": {
              "$ref": "#/$defs/AuditActor"
            },
            "payload": {
              "type": "object"
            },
            "traceCorrelation": {
              "type": "object"
            },
            "assertedActor": {
              "$ref": "#/$defs/AuditActor"
            },
            "actorVerification": {
              "enum": [
                "system",
                "authenticated-sdk",
                "authenticated-operator",
                "asserted"
              ]
            }
          }
        }
      ]
    },
    "AuditEvent": {
      "type": "object",
      "required": [
        "id",
        "tenantId",
        "category",
        "action",
        "severity",
        "occurredAt",
        "actor",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "deploymentId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "category": {
          "enum": [
            "tenant",
            "connector",
            "policy",
            "deployment",
            "session",
            "security",
            "approval",
            "runtime"
          ]
        },
        "action": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "error",
            "critical"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "$ref": "#/$defs/AuditActor"
        },
        "payload": {
          "type": "object"
        },
        "assertedActor": {
          "$ref": "#/$defs/AuditActor"
        },
        "actorVerification": {
          "enum": [
            "system",
            "authenticated-sdk",
            "authenticated-operator",
            "asserted"
          ]
        }
      }
    },
    "CipIngestEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "type"
          ],
          "properties": {
            "kind": {
              "const": "run_event"
            },
            "type": {
              "enum": [
                "run_started",
                "tool_called",
                "tool_completed",
                "handoff_started",
                "handoff_completed",
                "guardrail_triggered",
                "policy_decided",
                "approval_requested",
                "approval_resolved",
                "disclosure_presented",
                "disclosure_acknowledged",
                "human_review_completed",
                "output_overridden",
                "stop_invoked",
                "run_completed",
                "run_failed"
              ]
            },
            "actor": {
              "$ref": "#/$defs/AuditActor"
            },
            "payload": {
              "type": "object"
            },
            "traceCorrelation": {
              "type": "object"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "assertedActor": {
              "$ref": "#/$defs/AuditActor"
            },
            "actorVerification": {
              "enum": [
                "system",
                "authenticated-sdk",
                "authenticated-operator",
                "asserted"
              ],
              "description": "Trusted provenance for the persisted actor. Caller-supplied actor values on generic ingestion are treated as asserted, not verified."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "category",
            "action",
            "actor",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "audit_event"
            },
            "category": {
              "enum": [
                "tenant",
                "connector",
                "policy",
                "deployment",
                "session",
                "security",
                "approval",
                "runtime"
              ]
            },
            "action": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "info",
                "warn",
                "error",
                "critical"
              ]
            },
            "actor": {
              "$ref": "#/$defs/AuditActor"
            },
            "payload": {
              "type": "object"
            },
            "deploymentId": {
              "type": "string"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "assertedActor": {
              "$ref": "#/$defs/AuditActor"
            },
            "actorVerification": {
              "enum": [
                "system",
                "authenticated-sdk",
                "authenticated-operator",
                "asserted"
              ],
